NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep these secrets ONLY in Vercel Environment Variables, never commit their real values.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional: externally deployed Hanzo eSign instance; NOT required for built-in PDF stamping.
HANZO_ESIGN_URL=

# The Studio AI assistant remains OFF until the platform admin explicitly enables it in /admin/ai.
# Add only ONE provider key in Vercel Project Settings > Environment Variables (Production).
# NEVER commit or send these secret values in chat, issues, or public fields.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional OrcaRouter free-tier chat; never commit a real key.
ORCAROUTER_API_KEY=

# Phase 7 native build (server-side only; no real credentials in Git)
GITHUB_BUILD_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
STUDIO_RUNNER_TOKEN=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ENABLE_IOS_BUILDS=false
EXPO_PROJECT_ID=
# GitHub Actions repository Variables: STUDIO_BASE_URL=https://no-code-builder-saas.vercel.app
# GitHub Actions repository Secrets: STUDIO_RUNNER_TOKEN (must match Vercel), EXPO_TOKEN (iOS only)

# God-tier modules — provider credentials remain OFF until explicitly enabled.
# payOS merchant account and webhook URL configured by owner only.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Use true only after a live merchant verification and settlement approval.
COMMERCE_PAYMENTS_ENABLED=false
# Marketplace creator payouts are manual; do not enable until settlement is configured.
MARKETPLACE_SETTLEMENTS_ENABLED=false
# Allowlist additional owned main-platform domains (not customer domains).
PLATFORM_DOMAINS=
# Vercel Cron verifies CRON_SECRET. AI-generated SEO content stays in drafts.
CRON_SECRET=
AUTO_BLOG_ENABLED=false
